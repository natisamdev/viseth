PORT=8080
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost:8080
# Production / Render:
# BASE_URL=https://viseth.onrender.com

# Firebase Admin — local file OR inline JSON (preferred on Render)
FIREBASE_SERVICE_ACCOUNT_PATH=./viseth-hackathon-firebase-adminsdk-fbsvc-0a5622b086.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

QR_HMAC_SECRET=change-me-qr-hmac-secret-min-32-chars

# ── Telebirr (primary payments — NOT Chapa) ─────────────────
TELEBIRR_MODE=sandbox
# TELEBIRR_MOCK=true   # force mock checkout without calling Telebirr
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_SHORT_CODE=
TELEBIRR_PRIVATE_KEY_PATH=./secrets/telebirr_private.pem
# Or paste PEM with \n escapes:
# TELEBIRR_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
TELEBIRR_NOTIFY_URL=
TELEBIRR_REDIRECT_URL=

# Cron job token for /v1/jobs/*
JOB_TOKEN=change-me-job-token

FIRECRAWL_API_KEY=
WHISPERFLOW_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FAL_API_KEY=

# Cultural feed AI (Viseth Ai algorithm FastAPI) — leave blank to disable
CULTURAL_AI_BASE_URL=http://localhost:8000
CULTURAL_AI_SERVICE_KEY=viseth-ai-service-dev-key-change-in-prod

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEED_ADMIN_PASSWORD=VisethAdmin2026!

# Hackathon Flutter: Authorization: Bearer dev:usr_seed_traveler
# Also auto-enabled when TELEBIRR_MOCK / PAYMENTS_MODE=mock / Telebirr unset.
ALLOW_DEV_AUTH=true
